# Keep files that run on Linux as LF even when checked out on Windows: a
# service unit or shell script with CRLF endings fails ("bash\r: not found").
* text=auto
*.sh text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf
console/src/api/*.json text eol=lf
console/src/api/*.d.ts text eol=lf
