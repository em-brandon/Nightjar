#!/usr/bin/env bash
# Blocks a commit that adds a secret. Enable once per clone with: git config core.hooksPath .githooks
# Uses a local gitleaks if there is one, otherwise the Docker image. If neither exists it says so and fails,
# because a scanner that quietly skips is worse than none. Bypass deliberately with: git commit --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --config .gitleaks.toml --redact --no-banner
elif command -v docker >/dev/null 2>&1; then
  # Docker cannot see the staged index, so scan the working tree's staged files through git itself.
  MSYS_NO_PATHCONV=1 docker run --rm -v "$PWD:/repo" zricethezav/gitleaks:latest \
    protect --source /repo --staged --config /repo/.gitleaks.toml --redact --no-banner
else
  echo "pre-commit: neither gitleaks nor docker is installed, so staged changes were NOT scanned." >&2
  echo "Install gitleaks (https://github.com/gitleaks/gitleaks) or commit with --no-verify on purpose." >&2
  exit 1
fi
