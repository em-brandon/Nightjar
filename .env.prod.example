# Copy to .env on the VPS and fill in. Never commit the real one.
#
# This file holds settings that are NOT secret. Passwords and tokens live in files under ./secrets, made by
#   ./deploy/make-secrets.sh
# and mounted into the containers (docker-compose.yml), so they never appear in an environment variable, in `docker inspect`
# or in a crash dump. The hub refuses to start without the console token file.

HUB_DOMAIN=nightjar.yourdomain.co.ke

POSTGRES_USER=nightjar
POSTGRES_DB=nightjar

SPIKE_THRESHOLD=50
SPIKE_WINDOW_MIN=10

# The hub's public address (https://...). Pushover uses it for the console link in a push and for the callback that
# tells the hub a P1 was acknowledged on the phone. Without it the hub finds out by checking Pushover every 30 seconds.
HUB_PUBLIC_URL=

# Quiet hours: only P1 makes noise inside them. P2 is still delivered, just without sound.
# QUIET_TZ=Africa/Nairobi
# QUIET_START_HOUR=22
# QUIET_END_HOUR=7

# ---- Backups (deploy/backup.sh) ----
# The PUBLIC age key. Generate the pair on your laptop with age-keygen and keep the private key off the server.
# BACKUP_AGE_RECIPIENT=age1...
# RCLONE_REMOTE=b2:nightjar-backups

# ---- Secret files, in ./secrets (see deploy/make-secrets.sh) ----
#   postgres_password, database_url, console_token, pushover_callback_token   generated for you
#   pushover_token, pushover_user                                             yours: pushover.net/apps/build and your dashboard
#   deadman_url                                                               a healthchecks.io ping URL
#   presence_token                                                            for the NFC presence tap; empty disables it
