# Copy to .env on the VPS and fill in. Never commit the real one.

HUB_DOMAIN=nightjar.yourdomain.co.ke

POSTGRES_USER=nightjar
POSTGRES_DB=nightjar
# openssl rand -base64 32
POSTGRES_PASSWORD=

# Guards the console and everything under /api. REQUIRED: the hub refuses to
# start without it, because otherwise every write would be open to the internet.
# openssl rand -base64 32
CONSOLE_TOKEN=

SPIKE_THRESHOLD=50
SPIKE_WINDOW_MIN=10

# ---- Phone alerts (Pushover). Without the first two every alert fails visibly in the console. ----
# Create an application at https://pushover.net/apps/build and paste its API token here, and your own user key.
PUSHOVER_TOKEN=
PUSHOVER_USER=
# The hub's public address, and a long random secret for the acknowledgement callback's URL
# (openssl rand -hex 24). Both are needed for acknowledging a P1 on the phone to update the console at once;
# without them the hub still finds out by checking Pushover every RECEIPT_POLL_S seconds.
HUB_PUBLIC_URL=
PUSHOVER_CALLBACK_TOKEN=
# A healthchecks.io ping URL. The alert sender pings it only while it is alive, so a dead hub is noticed.
DEADMAN_URL=
# Quiet hours: only P1 makes noise inside them. P2 is still delivered, just without sound.
# QUIET_TZ=Africa/Nairobi
# QUIET_START_HOUR=22
# QUIET_END_HOUR=7
